# accounted-imap-intake — kopiera till .env och fyll i dina egna uppgifter

# ── IMAP-konto som tar emot fakturor (obligatoriskt) ──
IMAP_HOST=imap.dittforetag.se
IMAP_PORT=993
IMAP_USER=faktura@dittforetag.se
IMAP_PASS=ditt-lösenord

# ── Din Accounted-installation (obligatoriskt) ──
ACCOUNTED_URL=http://192.168.x.x:3000
ACCOUNTED_API_KEY=gnubok_sk_din-nyckel

# ── Valfritt ──
POLL_INTERVAL_MS=60000
